#!/usr/bin/env bash
# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>

pkgname=voidbr-plymouth-theme
pkgdesc="Plymouth theme for VoidLinuxBR"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(plymouth)
backup=()

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	[ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	# Install documentation if present
	[ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	# O que vale para todos os temas vem do voidbr-base-config:
	#   /etc/dracut.conf.d/10-plymouth.conf  módulo plymouth no initramfs
	#   /etc/dracut.conf.d/00-voidbr.conf    hostonly no sistema instalado
	#   /etc/grub.d/10_linux                 quiet splash fixo no GRUB
	# No Limine, o quiet splash vem fixo do voidbr-limine-config.
	# Aqui fica só o que é do tema: escolher o tema, colocá-lo no initramfs
	# e levar o initramfs novo para a ESP do Limine.

	# Sem o plymouth instalado, nada a configurar.
	if ! command -v plymouthd >/dev/null 2>&1 || ! command -v plymouth >/dev/null 2>&1; then
		log "plymouth não instalado — nada a configurar"
		return 0
	fi

	defaultPlymouthTheme="voidbr"
	themeDir="/usr/share/plymouth/themes/$defaultPlymouthTheme"

	# ======================================================
	# TEMA
	# ======================================================
	# Sem argumentos, o plymouth-set-default-theme só mostra o tema atual.
	# No upgrade, se o usuário trocou de tema, o pacote não mexe em mais nada.

	currentTheme="$(plymouth-set-default-theme 2>/dev/null || true)"

	if [ "${update:-}" = "yes" ] && [ "$currentTheme" != "$defaultPlymouthTheme" ]; then
		log "Tema atual é '$currentTheme' — mantendo a escolha do usuário"
		return 0
	fi

	if [ "$currentTheme" != "$defaultPlymouthTheme" ]; then
		log "Configurando tema Plymouth: $defaultPlymouthTheme"
		plymouth-set-default-theme "$defaultPlymouthTheme" || die "Falha ao configurar o Plymouth"
		log "Tema Plymouth configurado"
	else
		log "Tema Plymouth já é $defaultPlymouthTheme"
	fi

	# ======================================================
	# INITRAMFS
	# ======================================================
	# O tema só aparece no boot se estiver dentro do initramfs, e o hook do
	# kernel só refaz o initramfs quando um kernel é instalado/atualizado.
	# Por isso confere o de cada kernel em /boot (1 no mkiso/instalador, N no
	# sistema instalado) e só refaz o que não tem o tema atual — pela versão
	# de cada um, nunca pelo uname -r.

	if ! command -v dracut >/dev/null 2>&1; then
		log "dracut não encontrado, pulando initramfs"
		return 0
	fi

	# ISO roda em várias máquinas: initramfs genérico. O --no-hostonly é
	# explícito porque o 00-voidbr.conf (voidbr-base-config) define hostonly="yes".
	# Demais casos: hostonly (só os drivers da máquina).
	if [ -n "${MKISO_BUILD:-}" ]; then
		dracut_opts="--force --no-hostonly"
	else
		dracut_opts="--force --hostonly"
	fi

	# Versão anterior: refazia todos os initramfs sem conferir o tema.
	# initramfs_changed=0
	# for initramfs in /boot/initramfs-*.img; do
	# 	[ -f "$initramfs" ] || continue
	# 	kver="${initramfs#/boot/initramfs-}"
	# 	kver="${kver%.img}"
	# 	[ -d "/usr/lib/modules/$kver" ] || continue
	#
	# 	log "Recriando $initramfs"
	# 	if dracut $dracut_opts "$initramfs" "$kver"; then
	# 		initramfs_changed=1
	# 	else
	# 		log "dracut falhou para $kver — initramfs não atualizado"
	# 	fi
	# done

	initramfs_changed=0
	for initramfs in /boot/initramfs-*.img; do
		[ -f "$initramfs" ] || continue
		kver="${initramfs#/boot/initramfs-}"
		kver="${kver%.img}"
		[ -d "/usr/lib/modules/$kver" ] || continue

		# Já atualizado = todo arquivo do tema instalado existe dentro do
		# initramfs com o mesmo conteúdo (lsinitrd -f mostra o conteúdo).
		# Arquivo faltando ou diferente (tema novo, upgrade que mudou só uma
		# imagem, initramfs sem o plymouth) faz o cmp falhar e o initramfs
		# é refeito.
		if find "$themeDir" -type f | while IFS= read -r f; do
			lsinitrd -f "${f#/}" "$initramfs" 2>/dev/null | cmp -s - "$f" || exit 1
		done; then
			log "$initramfs já contém o tema $defaultPlymouthTheme atualizado"
			continue
		fi

		log "Recriando $initramfs"
		if dracut $dracut_opts "$initramfs" "$kver"; then
			initramfs_changed=1
		else
			log "dracut falhou para $kver — initramfs não atualizado"
		fi
	done

	if [ "$initramfs_changed" -eq 0 ]; then
		log "Nenhum initramfs recriado"
		return 0
	fi
	log "initramfs atualizado"

	# ======================================================
	# LIMINE
	# ======================================================
	# O update-limine copia kernel e initramfs para a ESP (/boot/efi/limine);
	# sem rodar, o boot pelo Limine continua com o initramfs antigo.
	# O GRUB lê o initramfs direto do /boot e não precisa de nada.
	# Na ISO não roda: no chroot do rootfs ele pegaria o UUID da raiz da máquina
	# que gera a ISO e gravaria um limine.conf errado dentro da ISO.

	if [ -n "${MKISO_BUILD:-}" ]; then
		log "ISO: update-limine não roda aqui"
	elif [ -x /usr/bin/update-limine ]; then
		log "Atualizando Limine"
		/usr/bin/update-limine || log "update-limine falhou — confira o limine.conf antes de reiniciar"
	fi
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}
